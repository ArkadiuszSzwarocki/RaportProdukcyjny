# RaportProdukcyjny environment configuration
# Copy to .env only on the target host. Never commit real credentials.

# Flask
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_MIN_32_CHARACTERS
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_TO_A_VALID_FERNET_KEY
# ENCRYPTION_KEY_PREVIOUS=
# LEGACY_SECRET_KEY=

# Database used by the application
DB_HOST=localhost
DB_PORT=3306
DB_USER=raportprodukcyjny
DB_PASSWORD=CHANGE_THIS_TO_YOUR_APP_DB_PASSWORD
DB_NAME=raportprodukcyjny
DB_CHARSET=utf8mb4
DB_SSL_DISABLED=false
# Docker Compose host exposure and MySQL root credentials are intentionally separate.
DB_HOST_PORT=3307
DB_ROOT_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_ROOT_PASSWORD
# Global runtime DB switching is a break-glass feature: masteradmin + this opt-in.
ALLOW_RUNTIME_DB_SWITCH=false

# Initial admin account
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_ONE_TIME_PASSWORD

# Web server
PORT=8082
HOST=0.0.0.0
WORKERS=6
SESSION_COOKIE_SECURE=true
APP_HOST_PORT=5005
# Use the exact sha-* image produced by the successful CI run, never :latest.
APP_IMAGE=ghcr.io/arkadiuszszwarocki/raportprodukcyjny:sha-REPLACE_WITH_TESTED_COMMIT_SHA

# Reverse proxy. Enable only when requests really arrive through a trusted proxy.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# Background workers. Web processes should normally keep this false;
# production Kubernetes runs one dedicated scripts/run_daemons.py process.
ENABLE_BACKGROUND_DAEMONS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ENABLE_REQUEST_LOGGING=false
ENABLE_SLOW_REQUEST_LOGGING=false

# Optional report generation
ENABLE_REPORT_GENERATION=true

# Authenticated print bridge
PRINTER_BRIDGE_URL=http://127.0.0.1:3001
PRINTER_BRIDGE_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_PRINT_BRIDGE_TOKEN
PRINTER_BRIDGE_AUTOSTART=false
PRINTER_BRIDGE_CONNECT_TIMEOUT=2
PRINTER_BRIDGE_READ_TIMEOUT=20
# For an HTTPS bridge signed by a private CA, mount the CA bundle and set:
# PRINTER_BRIDGE_CA_BUNDLE=/run/secrets/printer-ca.pem

# Print bridge process settings
PRINTER_BRIDGE_HOST=127.0.0.1
PRINTER_BRIDGE_PORT=3001
PRINTER_BRIDGE_ALLOW_SHUTDOWN=false
PRINTER_BRIDGE_ALLOWED_ORIGINS=
PRINTER_MAX_COPIES=20
PRINTER_MAX_ZPL_BYTES=2097152
# Configure actual printers only in deployment secrets/configuration, never source code.
# Example JSON shape (replace all values on the target host):
PRINTER_IP_MAP_JSON={"Warehouse":"10.0.0.10"}
PRINTER_VERIFY_LABEL_COUNT_IPS=192.168.1.160
PRINTER_NAME=Warehouse
PRINTER_IP=10.0.0.10
PRINTER_PORT=9100
PRINTER_TCP_PORTS=9100
PRINTER_ALLOW_DIRECT_TCP_FALLBACK=false

# TLS for the main application. Prefer TLS termination at a reverse proxy/Ingress.
USE_SSL=true
TLS_CERT_HOST_PATH=/secure-secrets/tls-cert.pem
TLS_KEY_HOST_PATH=/secure-secrets/tls-key.pem
# TLS_CERT_FILE=/run/secrets/tls-cert.pem
# TLS_KEY_FILE=/run/secrets/tls-key.pem

# MQTT
MQTT_BROKER_HOST=your-mqtt-broker.example.com
MQTT_BROKER_PORT=8883
MQTT_BROKER_USERNAME=your-mqtt-username
MQTT_BROKER_PASSWORD=CHANGE_THIS_TO_YOUR_MQTT_PASSWORD
MQTT_SUBSCRIBE_TOPICS=#

# Optional SMTP. No real provider/account defaults are compiled into the app.
# SMTP_SERVER=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=CHANGE_THIS_TO_YOUR_SMTP_PASSWORD
# SMTP_SECURITY=TLS
# Server-side SMTP tests/saves are restricted to these ports by default.
SMTP_ALLOWED_PORTS=25,465,587
# Comma-separated exact hostnames that are explicitly trusted, including any
# internal corporate SMTP hostname that resolves to a private address.
SMTP_ALLOWED_HOSTS=
# Keep private/loopback/link-local SMTP destinations blocked unless you have a
# controlled network reason to enable them. Prefer SMTP_ALLOWED_HOSTS instead.
SMTP_ALLOW_PRIVATE_HOSTS=false
# Plain SMTP without SSL/STARTTLS is blocked by default.
SMTP_ALLOW_PLAINTEXT=false

TZ=Europe/Warsaw

# Optional container updater / registry credentials
GHCR_USER=your-github-user
GHCR_TOKEN=CHANGE_THIS_TO_A_READ_PACKAGES_TOKEN
