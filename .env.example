# RaportProdukcyjny Environment Configuration
# Copy this file to .env and fill in actual values for your environment

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_MIN_32_CHARACTERS
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This must be separate from SECRET_KEY and stored only in the deployment secret store.
ENCRYPTION_KEY=CHANGE_THIS_TO_A_VALID_FERNET_KEY
# During a key rotation, set ENCRYPTION_KEY_PREVIOUS temporarily, then remove it after data migration.
# ENCRYPTION_KEY_PREVIOUS=
# Only for migrating records encrypted before ENCRYPTION_KEY existed. Remove after re-saving them.
# LEGACY_SECRET_KEY=

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=raportprodukcyjny
DB_PASSWORD=CHANGE_THIS_TO_YOUR_DB_PASSWORD
DB_NAME=raportprodukcyjny
DB_CHARSET=utf8mb4

# Admin Account (created at startup if INITIAL_ADMIN_PASSWORD is set)
INITIAL_ADMIN_PASSWORD=your-initial-admin-password

# Server Configuration
PORT=8082
HOST=0.0.0.0
WORKERS=6

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Optional: Report Generation
# (Leave empty if generator_raportow module is not available)
ENABLE_REPORT_GENERATION=true

# Print bridge configuration
# PRINTER_BRIDGE_URL is used by backend app service.
# For Docker/NAS this can point to a shared print gateway in LAN,
# e.g. https://192.168.1.50:3001 or http://192.168.1.50:3001
PRINTER_BRIDGE_URL=https://127.0.0.1:3001

# Optional: client-side fallback bridge for scanners/phones/browsers.
# If set, frontend fallback tries this endpoint first and then localhost.
# Example value: https://192.168.1.50:3001 (or http://... if app is served over HTTP)
PRINTER_CLIENT_BRIDGE_URL=
# Required only if the unauthenticated printer start/stop screen is enabled.
# PRINTER_SERVER_START_PIN=CHANGE_THIS_TO_A_LONG_RANDOM_PIN

# TLS key and certificate must be mounted outside the repository.
USE_SSL=true
# Absolute host paths used by docker-compose for read-only TLS mounts.
TLS_CERT_HOST_PATH=C:/secure-secrets/tls-cert.pem
TLS_KEY_HOST_PATH=C:/secure-secrets/tls-key.pem
# The application receives these container paths automatically from Compose.
# TLS_CERT_FILE=/run/secrets/tls-cert.pem
# TLS_KEY_FILE=/run/secrets/tls-key.pem

# MQTT broker configuration
# MQTT_BROKER_PASSWORD is required. Never commit a real broker password.
MQTT_BROKER_HOST=your-mqtt-broker.example.com
MQTT_BROKER_PORT=8883
MQTT_BROKER_USERNAME=your-mqtt-username
MQTT_BROKER_PASSWORD=CHANGE_THIS_TO_YOUR_MQTT_PASSWORD
MQTT_SUBSCRIBE_TOPICS=#

# Optional: Email sending (for shift close reports)
# SMTP_SERVER=mail.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password

# Timezone
TZ=Europe/Warsaw

# Watchtower – automatyczna aktualizacja kontenerów z ghcr.io
# Wygeneruj token na: https://github.com/settings/tokens (uprawnienie: read:packages)
GHCR_USER=arkadiuszszwarocki
GHCR_TOKEN=your-github-pat-with-read-packages
