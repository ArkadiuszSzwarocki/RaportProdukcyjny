# Example .env.example - copy to .env and fill secrets
# Backend
PORT=8089
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=MleczDroga

# App
JWT_SECRET=change_this_secret

# Frontend (Vite)
# Use full URL including /api (e.g. http://localhost:8089/api or https://mlecznadroga.mycloudnas.com/api)
VITE_API_URL=http://localhost:8089/api

# Notes:
# - Do NOT commit actual secrets. Keep .env in .gitignore.
# - For production, set secure secrets via your deployment system (GitHub Secrets, QNAP env, Docker env, etc.)
