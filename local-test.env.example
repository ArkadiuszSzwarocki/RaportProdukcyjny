# Local browser application; SQL connection settings come from the existing .env.
APP_INSTANCE_MODE=local
DB_NAME=biblioteka_testowa
DB_NAME_LOCKED=false
DB_POOL_SIZE=8
ALLOW_RUNTIME_DB_SWITCH=true
DB_ALLOW_LOCALHOST_FALLBACK=false
FLASK_ENV=development
FLASK_DEBUG=0
DEBUG=false
ENABLE_DEBUG_ROUTES=false
ENV=development
LOCAL_ENV=true
IS_LOCAL=true
HOST=127.0.0.1
PORT=8082
APP_BASE_URL=http://127.0.0.1:8082
TRUSTED_HOSTS=127.0.0.1,localhost
SESSION_COOKIE_SECURE=false
ENABLE_BACKGROUND_DAEMONS=true
ENABLE_MQTT_BRIDGE=true
ENABLE_AUTO_REPORT_SCHEDULER=true
PRINTER_BRIDGE_AUTOSTART=true
PRINTER_ALLOW_DIRECT_TCP_FALLBACK=true
SKIP_DB_SETUP=true
# A unique local session key is generated on first launch.
SECRET_KEY=
